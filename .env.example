# -----------------------------
# Shared AWS configuration
# -----------------------------
AWS_REGION=us-east-1
DYNAMODB_TABLE=comp4450-toxic-comment-predictions
# Leave blank in AWS. Set only for DynamoDB Local.
DYNAMODB_ENDPOINT_URL=

# -----------------------------
# Backend model configuration
# Production MUST use MODEL_SOURCE=wandb
# -----------------------------
MODEL_SOURCE=wandb
LOCAL_MODEL_PATH=artifacts/toxic_comment_model.joblib
MODEL_CACHE_DIR=.model_cache

# W&B Registry configuration
WANDB_ENTITY=YOUR_TEAM_ENTITY
WANDB_PROJECT=comp4450-toxic-comment-mlops
WANDB_REGISTRY=Models
WANDB_COLLECTION=toxic-comment-classifier
WANDB_MODEL_ALIAS=production
# Set this only in your shell/EC2 env file. Never commit a real key.
WANDB_API_KEY=YOUR_WANDB_API_KEY

# Assignment requires storing each prediction request. Keep true for grading.
STORE_RAW_TEXT=true

# -----------------------------
# User frontend
# -----------------------------
API_URL=http://127.0.0.1:8000
